-- Get the Carry Remote (RequestPrompt)
local function getCarryRemote()
    local RequestPrompt = ReplicatedStorage:FindFirstChild("RequestPrompt")
    if not RequestPrompt then
        -- Try to find it elsewhere
        RequestPrompt = ReplicatedStorage:FindFirstChild("Request")
    end
    return RequestPrompt
end

