-- ═══════════════ CORE LOGIC ═══════════════
local function updatePlayerList()
    for _, child in ipairs(scrollFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    local yOffset = 0
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local playerBtn = Instance.new("TextButton")
            playerBtn.Size = UDim2.new(1, -6, 0, 35)
            playerBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
            playerBtn.Text = "  " .. player.Name
            playerBtn.TextColor3 = Color3.fromRGB(200, 200, 220)
            playerBtn.TextSize = 12
            playerBtn.Font = Enum.Font.GothamSemibold
            playerBtn.TextXAlignment = Enum.TextXAlignment.Left
            playerBtn.Parent = scrollFrame
            Instance.new("UICorner", playerBtn).CornerRadius = UDim.new(0, 6)
            
            local checkmark = Instance.new("TextLabel")
            checkmark.Size = UDim2.new(0, 30, 1, 0)
            checkmark.Position = UDim2.new(1, -35, 0, 0)
            checkmark.BackgroundTransparency = 1
            checkmark.Text = "☐"
            checkmark.TextColor3 = Color3.fromRGB(100, 100, 120)
            checkmark.TextSize = 16
            checkmark.Font = Enum.Font.GothamBold
            checkmark.Parent = playerBtn
            
            if selectedTargets[player.Name] then
                playerBtn.BackgroundColor3 = Color3.fromRGB(60, 40, 100)
                checkmark.Text = "✓"
                checkmark.TextColor3 = Color3.fromRGB(150, 100, 255)
            end
            
            playerBtn.MouseButton1Click:Connect(function()
                if selectedTargets[player.Name] then
                    selectedTargets[player.Name] = nil
                    playerBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
                    checkmark.Text = "☐"
                    checkmark.TextColor3 = Color3.fromRGB(100, 100, 120)
                else
                    selectedTargets[player.Name] = player
                    playerBtn.BackgroundColor3 = Color3.fromRGB(60, 40, 100)
                    checkmark.Text = "✓"
                    checkmark.TextColor3 = Color3.fromRGB(150, 100, 255)
                end
                
                local count = 0
                for _ in pairs(selectedTargets) do count = count + 1 end
                countLabel.Text = "Selected: " .. count .. " player" .. (count ~= 1 and "s" or "")
            end)
            
            yOffset = yOffset + 40
        end
    end
    scrollFrame.CanvasSize = UDim2.new(0, 0, 0, math.max(yOffset, scrollFrame.AbsoluteSize.Y))
end

local function sendCarryRequest(targetPlayer)
    if not CarryRemote then
        CarryRemote = getCarryRemote()
        if not CarryRemote then return false end
    end
    local args = {70932517024004, CARRY_MESSAGE, targetPlayer, 0, 0.75, -1.5, 0, 0, 0}
    pcall(function() CarryRemote:FireServer(unpack(args)) end)
end

local function toggleCarrySpam()
    carrySpamActive = not carrySpamActive
    
    if carrySpamActive then
        local count = 0
        for _ in pairs(selectedTargets) do count = count + 1 end
        
        if count == 0 then
            toggleButton.Text = "⚠️ NO PLAYERS SELECTED"
            toggleGradient.Color = ColorSequence.new(Color3.fromRGB(150, 100, 50))
            carrySpamActive = false
            task.wait(1.5)
            toggleButton.Text = "START CARRY SPAM"
            toggleGradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(130, 50, 255)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 50, 150))
            })
            return
        end
        
        toggleButton.Text = "STOP CARRY SPAM"
        toggleGradient.Color = ColorSequence.new(Color3.fromRGB(200, 50, 50))
        
        carrySpamLoop = task.spawn(function()
            while carrySpamActive do
                for _, targetPlayer in pairs(selectedTargets) do
                    if targetPlayer and targetPlayer.Parent and carrySpamActive then
                        sendCarryRequest(targetPlayer)
                    end
                end
                task.wait(0.8)
            end
        end)
    else
        toggleButton.Text = "START CARRY SPAM"
        toggleGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(130, 50, 255)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 50, 150))
        })
        if carrySpamLoop then task.cancel(carrySpamLoop); carrySpamLoop = nil end
    end
end

toggleButton.MouseButton1Click:Connect(toggleCarrySpam)

selectAllBtn.MouseButton1Click:Connect(function()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then selectedTargets[player.Name] = player end
    end
    local count = 0
    for _ in pairs(selectedTargets) do count = count + 1 end
    countLabel.Text = "Selected: " .. count .. " players"
    updatePlayerList()
end)

deselectAllBtn.MouseButton1Click:Connect(function()
    selectedTargets = {}
    countLabel.Text = "Selected: 0 players"
    updatePlayerList()
    if carrySpamActive then toggleCarrySpam() end
end)

Players.PlayerAdded:Connect(function() task.wait(0.5); updatePlayerList() end)
Players.PlayerRemoving:Connect(function(player)
    task.wait(0.5)
    if selectedTargets[player.Name] then
        selectedTargets[player.Name] = nil
        local count = 0
        for _ in pairs(selectedTargets) do count = count + 1 end
        countLabel.Text = "Selected: " .. count .. " player" .. (count ~= 1 and "s" or "")
        if carrySpamActive and count == 0 then toggleCarrySpam() end
    end
    updatePlayerList()
end)

updatePlayerList()
