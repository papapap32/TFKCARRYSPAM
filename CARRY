-- Function to update player list
local function updatePlayerList()
    -- Clear existing
    for _, child in ipairs(scrollFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    local players = Players:GetPlayers()
    local yOffset = 0
    
    for _, player in ipairs(players) do
        if player ~= LocalPlayer then
            local playerBtn = Instance.new("TextButton")
            playerBtn.Size = UDim2.new(1, 0, 0, 45)
            playerBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 50)
            playerBtn.BackgroundTransparency = 0
            playerBtn.Text = "  👤 " .. player.Name
            playerBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            playerBtn.TextSize = 13
            playerBtn.Font = Enum.Font.Gotham
            playerBtn.TextXAlignment = Enum.TextXAlignment.Left
            playerBtn.Parent = scrollFrame
            
            local btnCorner = Instance.new("UICorner")
            btnCorner.CornerRadius = UDim.new(0, 6)
            btnCorner.Parent = playerBtn
            
            -- Checkmark for selected
            local checkmark = Instance.new("TextLabel")
            checkmark.Size = UDim2.new(0, 35, 1, 0)
            checkmark.Position = UDim2.new(1, -40, 0, 0)
            checkmark.BackgroundTransparency = 1
            checkmark.Text = "☐"
            checkmark.TextColor3 = Color3.fromRGB(150, 150, 170)
            checkmark.TextSize = 18
            checkmark.Font = Enum.Font.GothamBold
            checkmark.Parent = playerBtn
            
            -- Check if selected
            if selectedTargets[player.Name] then
                playerBtn.BackgroundColor3 = Color3.fromRGB(60, 50, 120)
                checkmark.Text = "✓"
                checkmark.TextColor3 = Color3.fromRGB(100, 200, 100)
            end
            
            -- Click handler
            playerBtn.MouseButton1Click:Connect(function()
                if selectedTargets[player.Name] then
                    selectedTargets[player.Name] = nil
                    playerBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 50)
                    checkmark.Text = "☐"
                    checkmark.TextColor3 = Color3.fromRGB(150, 150, 170)
                else
                    selectedTargets[player.Name] = player
                    playerBtn.BackgroundColor3 = Color3.fromRGB(60, 50, 120)
                    checkmark.Text = "✓"
                    checkmark.TextColor3 = Color3.fromRGB(100, 200, 100)
                end
                
                -- Update count
                local count = 0
                for _ in pairs(selectedTargets) do count = count + 1 end
                countLabel.Text = "Selected: " .. count .. " player" .. (count ~= 1 and "s" or "")
            end)
            
            yOffset = yOffset + 50
        end
    end
    
    scrollFrame.CanvasSize = UDim2.new(0, 0, 0, math.max(yOffset, scrollFrame.AbsoluteSize.Y))
end

-- Function to send carry request to a player
local function sendCarryRequest(targetPlayer)
    if not CarryRemote then
        CarryRemote = getCarryRemote()
        if not CarryRemote then
            return false
        end
    end
    
    -- Args format: {70932517024004, carryName, targetPlayer, 0, 0.75, -1.5, 0, 0, 0}
    local args = {70932517024004, CARRY_MESSAGE, targetPlayer, 0, 0.75, -1.5, 0, 0, 0}
    
    local success, err = pcall(function()
        CarryRemote:FireServer(unpack(args))
    end)
    
    return success
end

-- Toggle Carry Spam
local function toggleCarrySpam()
    carrySpamActive = not carrySpamActive
    
    if carrySpamActive then
        if not CarryRemote then
            CarryRemote = getCarryRemote()
            if not CarryRemote then
                toggleButton.Text = "❌ Remote Not Found!"
                toggleButton.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
                carrySpamActive = false
                task.wait(2)
                toggleButton.Text = "📦 Carry Spam: OFF"
                toggleButton.BackgroundColor3 = Color3.fromRGB(80, 60, 150)
                return
            end
        end
        
        -- Check if any players are selected
        local count = 0
        for _ in pairs(selectedTargets) do count = count + 1 end
        
        if count == 0 then
            toggleButton.Text = "⚠️ No Players Selected!"
            toggleButton.BackgroundColor3 = Color3.fromRGB(150, 100, 50)
            carrySpamActive = false
            task.wait(1.5)
            toggleButton.Text = "📦 Carry Spam: OFF"
            toggleButton.BackgroundColor3 = Color3.fromRGB(80, 60, 150)
            return
        end
        
        toggleButton.Text = "📦 Carry Spam: ON"
        toggleButton.BackgroundColor3 = Color3.fromRGB(50, 150, 80)
        statusIndicator.BackgroundColor3 = Color3.fromRGB(50, 255, 50)
        
        -- Start carry spam loop
        if carrySpamLoop then task.cancel(carrySpamLoop) end
        carrySpamLoop = task.spawn(function()
            while carrySpamActive do
                local targets = {}
                for _, targetPlayer in pairs(selectedTargets) do
                    if targetPlayer and targetPlayer.Parent then
                        table.insert(targets, targetPlayer)
                    end
                end
                
                -- Send carry request to each selected player
                for _, target in ipairs(targets) do
                    if carrySpamActive then
                        sendCarryRequest(target)
                    end
                end
                
                -- Wait 0.8 seconds before next cycle
                task.wait(0.8)
            end
        end)
    else
        toggleButton.Text = "📦 Carry Spam: OFF"
        toggleButton.BackgroundColor3 = Color3.fromRGB(80, 60, 150)
        statusIndicator.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
        
        if carrySpamLoop then
            task.cancel(carrySpamLoop)
            carrySpamLoop = nil
        end
    end
end

toggleButton.MouseButton1Click:Connect(toggleCarrySpam)

